APP_ENV=development
LOG_LEVEL=INFO
OPENAI_API_KEY=sk-proj-...

# Friday Chat model-library credentials. Copy this file to .env, replace the
# placeholders, then source it before startup; Friday Chat does not load it
# automatically.
FRIDAY_LLM_API_KEY=replace-with-local-endpoint-key
FRIDAY_OPENROUTER_API_KEY=replace-with-openrouter-key
