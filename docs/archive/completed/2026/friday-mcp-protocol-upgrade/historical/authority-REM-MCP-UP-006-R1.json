      "normative_source": {
        "capture": "inputs/normative/specification--2026-07-28--basic--transports--streamable-http.md",
        "sha256": "93daa4bb4e189f0bd51d866950b3b8a3b4e7d0b1e0e6eede5ba1998641d0b955",
        "lines": [
          479,
          480,
