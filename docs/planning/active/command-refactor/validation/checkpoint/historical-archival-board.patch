+                        ".." in relative.parts
+                        or relative.is_absolute()
+                        or not (root / relative).is_file()
+                    ):
+                        errors.append(
+                            f"{label}.validation[{number}] references missing "
+                            f"evidence: {evidence_path}"
+                        )
+            if TASK_ID_PATTERN.fullmatch(task_id):
