+            validation = task.get("validation")
+            if isinstance(validation, list):
+                for number, entry in enumerate(validation):
+                    if not isinstance(entry, str):
+                        continue
+                    evidence_path = entry.split(" (", 1)[0].split(": ", 1)[0]
