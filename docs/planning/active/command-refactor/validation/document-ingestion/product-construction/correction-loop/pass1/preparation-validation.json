{
  "scope": "Safe planning-only administration. Whole-worktree user-YAML whitespace not displayed or repaired.",
  "administration": [
    {
      "name": "board",
      "argv": [
        "uv",
        "run",
        "--offline",
        "--frozen",
        "--no-sync",
        "--no-python-downloads",
        "python",
        "-B",
        "scripts/friday-dev-board.py",
        "validate"
      ],
      "exit": 0,
      "stdout": "Development board validation passed: 36 tasks\n",
      "stderr": ""
    },
    {
      "name": "dashboard",
      "argv": [
        "uv",
        "run",
        "--offline",
        "--frozen",
        "--no-sync",
        "--no-python-downloads",
        "python",
        "-B",
        "scripts/friday-dev-board.py",
        "render",
        "--check"
      ],
      "exit": 0,
      "stdout": "Planning dashboard is current\n",
      "stderr": ""
    },
    {
      "name": "docs",
      "argv": [
        "uv",
        "run",
        "--offline",
        "--frozen",
        "--no-sync",
        "--no-python-downloads",
        "python",
        "-B",
        "scripts/check-documentation-lifecycle.py"
      ],
      "exit": 0,
      "stdout": "Documentation lifecycle validation passed: 1143 Markdown files checked\n",
      "stderr": ""
    },
    {
      "name": "metadata",
      "argv": [
        "uv",
        "run",
        "--offline",
        "--frozen",
        "--no-sync",
        "--no-python-downloads",
        "python",
        "-B",
        "scripts/check-package-metadata.py"
      ],
      "exit": 0,
      "stdout": "Validated 18 pyproject.toml files: version, license, authors, README, URLs, wheel package selection, and internal pins OK\n",
      "stderr": ""
    },
    {
      "name": "owned-whitespace",
      "argv": [
        "git",
        "diff",
        "--check",
        "--",
        "docs/planning"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "name": "staged-whitespace",
      "argv": [
        "git",
        "diff",
        "--cached",
        "--check",
        "--",
        "docs/planning"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    }
  ],
  "not_a_review_or_qualification": true
}
